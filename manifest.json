{
  "manifest_version": 3,
  "name": "GeoGuessr CS2 Ranks",
  "version": "1.2.1",
  "description": "Replace GeoGuessr division badges with CS2 skill group icons, Premier ratings, and Premier medals.",
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["ranks.js", "medals.js", "content.js", "medals-content.js", "premier.js"],
      "css": ["premier.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.geoguessr.com/*"]
    }
  ]
}
