{
  "manifest_version": 3,
  "name": "GeoGuessr CS2 Ranks",
  "version": "1.6.0",
  "description": "Replace GeoGuessr division badges with CS2 skill group icons, Premier ratings, and Premier medals.",
  "browser_specific_settings": {
    "gecko": {
      "id": "geoguessr-cs2-ranks@open-source",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.geoguessr.com/*"
      ],
      "js": [
        "src/icons.js",
        "src/ranks.js",
        "src/medals.js",
        "src/content.js",
        "src/medals-content.js",
        "src/premier.js",
        "src/multiplier.js"
      ],
      "css": [
        "src/premier.css",
        "src/multiplier.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://www.geoguessr.com/*"
      ]
    }
  ]
}